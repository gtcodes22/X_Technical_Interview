# Copy to .env and fill in. .env is git-ignored; set the same variables in Netlify per deploy context.

# LLM — provider of the key supplied for the assessment (e.g. anthropic, openai)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_TOKEN_BUDGET=50000

# Staff page access (shared token — see OPERATIONS.md §4)
STAFF_TOKEN=dev

# Simulated date for all date logic (assessment "today")
APP_TODAY=2026-10-06
# Optional clock override for demos/tests, Botswana time, e.g. 2026-10-06T19:30:00+02:00
APP_NOW=
